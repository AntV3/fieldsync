# FieldSync Environment Configuration
# Copy this file to .env.local for local development
#
# Environment modes (Vite built-in):
#   .env.local          → Local development (gitignored)
#   .env.staging        → Staging builds (npm run build:staging)
#   .env.production     → Production builds (npm run build)
#
# Get credentials from your Supabase project dashboard: Settings > API
# IMPORTANT: Never commit real credentials to version control

# --- Required ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Transactional email (Resend via the send-email Edge Function) ---
# NONE of these go in .env.local or any VITE_ variable: the browser never sees them.
# They are Edge Function secrets, set once (and again on rotation) with:
#   npx supabase secrets set RESEND_API_KEY=... EMAIL_FROM="..." APP_BASE_URL=... EMAIL_WORKER_SECRET=...
# then deploy: npx supabase functions deploy send-email --no-verify-jwt
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to the function by the platform.
#
# Resend API key with "Sending access" only (resend.com -> API Keys); sending domain must be Verified.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Platform sender on the verified subdomain. Emails go out as "<Company> via FieldSync",
# or just "<Company>" for companies that hide FieldSync branding; Reply-To is the requester/owner.
# EMAIL_FROM=FieldSync <noreply@mail.yourdomain.com>
# Public app origin used in email links (no trailing slash); signing links are <APP_BASE_URL>/sign/<token>.
# APP_BASE_URL=https://app.yourdomain.com
# Shared secret the database sends in the x-email-worker-secret header (random, 32+ characters).
# Must equal the Vault secret 'email_worker_secret' below.
# EMAIL_WORKER_SECRET=replace-with-a-random-32-plus-character-string
#
# The database side reads the function URL and the same secret from Supabase Vault (SQL Editor):
#   select vault.create_secret('https://<project-ref>.supabase.co/functions/v1/send-email', 'email_worker_url');
#   select vault.create_secret('<same value as EMAIL_WORKER_SECRET>', 'email_worker_secret');
# Without these two Vault secrets emails stay queued (status 'pending') until they are added.
